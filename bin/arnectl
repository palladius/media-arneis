#!/usr/bin/env ruby

=begin
Arneis (Media Harness) - A kubectl-like tool for media creation.
This tool orchestrates complex media projects (Videos, Stories, Comic Books)
using Google's AI models (Gemini, Lyria, Nanobanana, Veo, Chirp).

Usage:
  arnectl apply <yaml_path>
  arnectl status <folder_path>
  arnectl version
=end

# Auto-switch to rbenv Ruby if available and not already using the correct version
if File.exist?(File.expand_path("~/.rbenv/bin/rbenv")) && !ENV['BUNDLE_GEMFILE']
  ENV['PATH'] = "#{File.expand_path('~/.rbenv/shims')}:#{ENV['PATH']}"
  if `ruby -v`.split[1] != "3.4.5"
    exec "RBENV_VERSION=3.4.5 bundle exec ruby #{__FILE__} #{ARGV.join(' ')}"
  end
end

require 'bundler/setup'
require 'zeitwerk'

loader = Zeitwerk::Loader.new
loader.push_dir("#{__dir__}/../lib")
loader.setup

Arneis::Cli.start(ARGV)
